{
	auto_https off
	admin off

	# Clients reach the relay at a bare IP, and RFC 6066 forbids an IP literal
	# in SNI, so neither Go's crypto/tls nor curl sends a server name at all.
	# Caddy selects certificates by name and has none to match, so without a
	# default the handshake dies with an internal_error alert before the
	# certificate is ever offered.
	default_sni {$WSN_PUBLIC_IP}
}

https://{$WSN_PUBLIC_IP} {
	tls /etc/wsn/relay.crt /etc/wsn/relay.key {
		protocols tls1.3
	}

	# Both branches must be handle blocks. Caddy sorts directives by its own
	# order rather than by the order written here, and a bare `respond 404`
	# sorts ahead of `reverse_proxy` with a matcher that accepts everything,
	# so it would answer /wsn as well and the relay would never see a client.
	handle /wsn {
		reverse_proxy relay:8080
	}

	handle {
		respond 404
	}
}
