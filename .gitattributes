# The installer scripts and systemd units in internal/provision/assets are
# embedded with go:embed and executed on Linux. A Windows checkout with
# core.autocrlf=true would give them CRLF, and the kernel then reads the shebang
# of install-linux.sh as "/bin/sh\r" and reports the interpreter as missing, so
# every Linux bundle built on that machine is dead on arrival. Pin LF.
* text=auto eol=lf

# PowerShell installers only ever run on Windows.
*.ps1 text eol=crlf

*.exe binary
*.tar.gz binary
*.zip binary
